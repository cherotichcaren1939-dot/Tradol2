<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Catalog (KSH)</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f0f2f5;
            padding: 15px;
            min-height: 100vh;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
        }

        h1 {
            text-align: center;
            color: #2c3e50;
            margin-bottom: 15px;
            font-size: 22px;
        }

        /* ===== Form ===== */
        .form-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            padding: 15px;
            margin-bottom: 20px;
        }

        .form-card h2 {
            font-size: 16px;
            color: #34495e;
            margin-bottom: 12px;
        }

        .image-picker {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
            padding: 10px;
            border: 2px dashed #bdc3c7;
            border-radius: 8px;
            cursor: pointer;
            transition: border-color 0.2s;
        }

        .image-picker:hover {
            border-color: #3498db;
        }

        .image-picker img {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 8px;
            background: #ecf0f1;
            display: none;
        }

        .image-picker .placeholder-icon {
            width: 70px;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ecf0f1;
            border-radius: 8px;
            font-size: 30px;
            color: #95a5a6;
        }

        .image-picker .label-text {
            font-size: 13px;
            color: #7f8c8d;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 12px;
        }

        .form-grid input {
            width: 100%;
            padding: 11px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 14px;
            outline: none;
            transition: border 0.2s;
        }

        .form-grid input:focus {
            border-color: #3498db;
        }

        .form-grid input.full {
            grid-column: 1 / -1;
        }

        .add-btn {
            width: 100%;
            padding: 13px;
            background: #27ae60;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 15px;
            font-weight: 600;
            transition: background 0.2s;
        }

        .add-btn:hover {
            background: #219150;
        }

        .add-btn:disabled {
            background: #95a5a6;
            cursor: not-allowed;
        }

        /* ===== Product grid ===== */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 16px;
        }

        .product-card {
            background: white;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
            display: flex;
            flex-direction: column;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .product-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 18px rgba(0,0,0,0.12);
        }

        .product-image {
            width: 100%;
            aspect-ratio: 4 / 3;
            object-fit: cover;
            background: #ecf0f1;
            display: block;
        }

        .product-image-placeholder {
            width: 100%;
            aspect-ratio: 4 / 3;
            background: linear-gradient(135deg, #ecf0f1, #d5dbdb);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 50px;
            color: #95a5a6;
        }

        .product-info {
            padding: 12px 14px 14px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            flex: 1;
        }

        .product-name {
            font-size: 16px;
            font-weight: 600;
            color: #2c3e50;
            line-height: 1.3;
        }

        .product-price {
            font-size: 18px;
            font-weight: 700;
            color: #27ae60;
        }

        .product-meta {
            font-size: 12.5px;
            color: #7f8c8d;
            display: flex;
            align-items: center;
            gap: 5px;
            line-height: 1.4;
        }

        .product-meta span.icon {
            font-size: 13px;
        }

        .product-actions {
            margin-top: 8px;
            display: flex;
            gap: 8px;
        }

        .call-btn {
            flex: 1;
            padding: 8px;
            background: #3498db;
            color: white;
            text-align: center;
            border-radius: 6px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            border: none;
            cursor: pointer;
        }

        .call-btn:hover {
            background: #2980b9;
        }

        .delete-btn {
            background: #ecf0f1;
            color: #e74c3c;
            border: none;
            padding: 8px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
        }

        .delete-btn:hover {
            background: #fdecea;
        }

        /* ===== Status ===== */
        .status {
            text-align: center;
            padding: 30px 15px;
            color: #7f8c8d;
            font-size: 14px;
        }

        .status.error {
            color: #e74c3c;
        }

        @media (max-width: 500px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
            .products-grid {
                grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
                gap: 12px;
            }
            .product-name { font-size: 14px; }
            .product-price { font-size: 16px; }
            .product-info { padding: 10px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🛒 Product Catalog (KSH)</h1>

        <!-- Add Product Form -->
        <div class="form-card">
            <h2>Add New Product</h2>

            <!-- Image Picker -->
            <label class="image-picker" for="imageInput">
                <div class="placeholder-icon" id="pickerIcon">📷</div>
                <img id="imagePreview" alt="Preview">
                <div class="label-text">
                    <strong>Tap to add a photo</strong><br>
                    <span style="font-size:11px;">Choose from gallery or camera</span>
                </div>
            </label>
            <input type="file" id="imageInput" accept="image/*" style="display:none;">

            <div class="form-grid">
                <input type="text" id="productName" placeholder="Product name" required>
                <input type="number" id="productCost" placeholder="Cost (KSH)" min="0" step="0.01" required>
                <input type="text" id="productLocation" placeholder="Where to find it" required>
                <input type="tel" id="productPhone" placeholder="Phone number" required>
            </div>

            <button class="add-btn" id="addBtn">➕ Add Product</button>
        </div>

        <!-- Products Grid -->
        <div id="productsGrid" class="products-grid"></div>
        <div id="statusMessage" class="status">Loading products...</div>
    </div>

    <!-- Firebase SDK -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
        import {
            getFirestore, collection, addDoc, deleteDoc, doc,
            onSnapshot, query, orderBy
        } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
        import {
            getStorage, ref, uploadBytes, getDownloadURL, deleteObject
        } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-storage.js";

        // ✅ Your Firebase config
        const firebaseConfig = {
            apiKey: "AIzaSyDIi2SyI8jsS82Yzb5SGmmdalSieeAJhns",
            authDomain: "trade-2c56d.firebaseapp.com",
            projectId: "trade-2c56d",
            storageBucket: "trade-2c56d.firebasestorage.app",
            messagingSenderId: "458341053512",
            appId: "1:458341053512:web:0a7bce1f7d430e5a45947d",
            measurementId: "G-H1LGNW7LJD"
        };

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);
        const storage = getStorage(app);
        const productsCollection = collection(db, "products");

        // DOM
        const grid = document.getElementById('productsGrid');
        const statusMessage = document.getElementById('statusMessage');
        const addBtn = document.getElementById('addBtn');
        const imageInput = document.getElementById('imageInput');
        const imagePreview = document.getElementById('imagePreview');
        const pickerIcon = document.getElementById('pickerIcon');
        const nameInput = document.getElementById('productName');
        const costInput = document.getElementById('productCost');
        const locationInput = document.getElementById('productLocation');
        const phoneInput = document.getElementById('productPhone');

        let selectedImageBlob = null;

        // ===== Image picker preview =====
        imageInput.addEventListener('change', async (e) => {
            const file = e.target.files[0];
            if (!file) return;
            try {
                const blob = await resizeImage(file, 1000, 0.8);
                selectedImageBlob = blob;
                imagePreview.src = URL.createObjectURL(blob);
                imagePreview.style.display = 'block';
                pickerIcon.style.display = 'none';
            } catch (err) {
                console.error(err);
                alert('Could not load image.');
            }
        });

        // ===== Resize & compress image before upload =====
        function resizeImage(file, maxWidth, quality) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const img = new Image();
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        let w = img.width, h = img.height;
                        if (w > maxWidth) {
                            h = Math.round((maxWidth / w) * h);
                            w = maxWidth;
                        }
                        canvas.width = w;
                        canvas.height = h;
                        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
                        canvas.toBlob(
                            (blob) => blob ? resolve(blob) : reject('toBlob failed'),
                            'image/jpeg',
                            quality
                        );
                    };
                    img.onerror = reject;
                    img.src = e.target.result;
                };
                reader.onerror = reject;
                reader.readAsDataURL(file);
            });
        }

        // ===== Format currency =====
        function formatCost(amount) {
            return 'KSH ' + Number(amount).toLocaleString('en-KE', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text == null ? '' : String(text);
            return div.innerHTML;
        }

        // ===== Render product cards =====
        function renderProducts(snapshot) {
            grid.innerHTML = '';
            if (snapshot.empty) {
                statusMessage.textContent = 'No products yet. Add your first one above!';
                statusMessage.className = 'status';
                statusMessage.style.display = 'block';
                return;
            }
            statusMessage.style.display = 'none';

            snapshot.forEach((docSnap) => {
                const data = docSnap.data();
                const card = document.createElement('div');
                card.className = 'product-card';

                const imageHtml = data.imageUrl
                    ? `<img class="product-image" src="${escapeHtml(data.imageUrl)}" alt="${escapeHtml(data.name)}" loading="lazy">`
                    : `<div class="product-image-placeholder">🛍️</div>`;

                card.innerHTML = `
                    ${imageHtml}
                    <div class="product-info">
                        <div class="product-name">${escapeHtml(data.name)}</div>
                        <div class="product-price">${formatCost(data.cost)}</div>
                        <div class="product-meta"><span class="icon">📍</span> ${escapeHtml(data.location)}</div>
                        <div class="product-meta"><span class="icon">📞</span> ${escapeHtml(data.phone)}</div>
                        <div class="product-actions">
                            <a class="call-btn" href="tel:${escapeHtml(data.phone)}">Call</a>
                            <button class="delete-btn" data-id="${docSnap.id}" data-image="${escapeHtml(data.imagePath || '')}">🗑️</button>
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });

            document.querySelectorAll('.delete-btn').forEach(btn => {
                btn.addEventListener('click', async function () {
                    if (!confirm('Delete this product?')) return;
                    const id = this.getAttribute('data-id');
                    const imagePath = this.getAttribute('data-image');
                    try {
                        if (imagePath) {
                            try { await deleteObject(ref(storage, imagePath)); }
                            catch (e) { console.warn('Image delete skipped:', e.message); }
                        }
                        await deleteDoc(doc(db, 'products', id));
                    } catch (err) {
                        console.error(err);
                        alert('Failed to delete. See console.');
                    }
                });
            });
        }

        // ===== Real-time listener =====
        const q = query(productsCollection, orderBy('createdAt', 'desc'));
        onSnapshot(q, renderProducts, (error) => {
            console.error(error);
            statusMessage.textContent = 'Error loading products.';
            statusMessage.className = 'status error';
            statusMessage.style.display = 'block';
        });

        // ===== Add product =====
        async function addProduct() {
            const name = nameInput.value.trim();
            const cost = parseFloat(costInput.value);
            const location = locationInput.value.trim();
            const phone = phoneInput.value.trim();

            if (!name || isNaN(cost) || !location || !phone) {
                alert('Please fill in all fields with valid data.');
                return;
            }

            addBtn.disabled = true;
            addBtn.textContent = 'Uploading...';

            try {
                let imageUrl = null;
                let imagePath = null;

                if (selectedImageBlob) {
                    const fileName = `products/${Date.now()}_${Math.random().toString(36).slice(2)}.jpg`;
                    const storageRef = ref(storage, fileName);
                    await uploadBytes(storageRef, selectedImageBlob);
                    imageUrl = await getDownloadURL(storageRef);
                    imagePath = fileName;
                }

                await addDoc(productsCollection, {
                    name,
                    cost,
                    location,
                    phone,
                    imageUrl,
                    imagePath,
                    createdAt: new Date()
                });

                // Reset
                nameInput.value = '';
                costInput.value = '';
                locationInput.value = '';
                phoneInput.value = '';
                imageInput.value = '';
                imagePreview.style.display = 'none';
                imagePreview.src = '';
                pickerIcon.style.display = 'flex';
                selectedImageBlob = null;
            } catch (err) {
                console.error(err);
                alert('Failed to add product. See console for details.');
            } finally {
                addBtn.disabled = false;
                addBtn.textContent = '➕ Add Product';
            }
        }

        addBtn.addEventListener('click', addProduct);
        [nameInput, costInput, locationInput, phoneInput].forEach(inp => {
            inp.addEventListener('keypress', e => {
                if (e.key === 'Enter') addProduct();
            });
        });
    </script>
</body>
</html>
